{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "lib": ["ESNext"],
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,

  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
